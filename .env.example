# ============================================================
# AppForge — environment variables
# Copy this file to .env and fill in real values
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Database ---
POSTGRES_USER=appforge
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=appforge
DATABASE_URL=postgresql+asyncpg://appforge:changeme_in_production@postgres:5432/appforge

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_long_random_secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_me_with_fernet_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PLATFORM_SSH_KEY_PATH=/app/keys/platform_key

# --- Frontend (NEXT_PUBLIC_* exposed to browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
